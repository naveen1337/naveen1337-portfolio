---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArticleItem from '../components/ArticleItem.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import config from '../data/write-ups.config.json';
import { generateCollectionSchema } from '../lib/schema';

// ── Load & sort posts ────────────────────────────────────────────────────────
function parseDateStr(d: string): number {
  const months: Record<string, number> = {
    Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
    Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11,
  };
  const [mon, yr] = d.split(' ');
  return new Date(parseInt(yr), months[mon] ?? 0, 1).getTime();
}

const allPosts = await getCollection('write-ups');
const posts = allPosts.sort((a, b) => parseDateStr(b.data.date) - parseDateStr(a.data.date));

// ── Compute category counts ──────────────────────────────────────────────────
const categoryCounts = new Map<string, number>();
posts.forEach(p => {
  categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) ?? 0) + 1);
});

const sidebarCategories = [
  { name: 'All Write-ups', count: posts.length },
  ...config.categories
    .filter(cat => categoryCounts.has(cat))
    .map(cat => ({ name: cat, count: categoryCounts.get(cat)! })),
];

// ── Compute tag counts (config tags only) ────────────────────────────────────
const tagCounts = new Map<string, number>();
posts.forEach(p => {
  p.data.tags.forEach(tag => {
    if ((config.tags as string[]).includes(tag)) {
      tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    }
  });
});

const sidebarTags = config.tags
  .filter(t => tagCounts.has(t))
  .map(t => ({ name: t, count: tagCounts.get(t)! }));

const { pageSize } = config.pagination;

// SEO Meta Tags for write-ups page
const pageTitle = 'All Write-ups | Naveen — Full-Stack Developer';
const pageDescription = 'Explore write-ups on software engineering, cloud infrastructure, personal projects, reading lists, and technology insights from a full-stack developer in Tamil Nadu, India.';
const pageKeywords = 'write-ups, articles, software engineering, technology, web development, cloud infrastructure, full stack developer, Tamil Nadu, India';

// JSON-LD Schema for collection page
const collectionSchema = generateCollectionSchema({
  url: 'https://naveen37.com/write-ups',
  name: pageTitle,
  description: pageDescription,
  itemCount: posts.length,
});
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <div class="min-h-screen pb-16">
    <Navbar />

    <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
    <div class="px-4 sm:px-8 lg:px-14 py-10 lg:py-14 border-b border-slate-100 dark:border-[#1B263B]">
      <div class="max-w-2xl">
        <p class="text-accent text-xs uppercase tracking-widest font-semibold m-0 mb-3">Writing</p>
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 dark:text-[#F3F7FF] m-0 mb-4 leading-tight">
          All Write-ups
        </h1>
        <p class="text-secondary text-base lg:text-lg m-0 leading-relaxed">
          Notes on software projects, book reviews, and thoughts on engineering, finance, and the
          craft of building things.
        </p>
      </div>
    </div>

    <!-- ─── Main content ──────────────────────────────────────────────────── -->
    <div class="px-4 sm:px-8 lg:px-14 mt-8">
      <div class="flex flex-col lg:flex-row lg:gap-12 lg:items-start">

        <!-- ─── Sidebar ────────────────────────────────────────────────────── -->
        <aside class="w-full lg:w-[260px] lg:shrink-0 lg:sticky lg:top-6 lg:self-start">

          <!-- Mobile filter toggle (hidden on lg) -->
          <button
            id="filter-toggle"
            class="lg:hidden w-full flex items-center justify-between px-4 py-3 border border-slate-200 dark:border-[#24324A] text-sm font-semibold text-slate-900 dark:text-[#F3F7FF] hover:border-accent dark:bg-[#111827] transition-colors mb-4"
            aria-expanded="false"
            aria-controls="filter-panel"
          >
            <span class="flex items-center gap-2">
              <Icon name="lucide:sliders-horizontal" class="size-4 text-accent" />
              Filter &amp; Browse
            </span>
            <Icon name="lucide:chevron-down" class="size-4 text-secondary transition-transform" id="filter-chevron" />
          </button>

          <!-- Filter panel: hidden on mobile until toggled, always visible on lg -->
          <div id="filter-panel" class="hidden lg:flex flex-col gap-8">

            <!-- Categories -->
            <div>
              <p class="text-xs uppercase tracking-widest font-semibold text-secondary m-0 mb-3">
                Categories
              </p>
              <nav aria-label="Write-up categories">
                <ul class="list-none m-0 p-0 flex flex-col gap-0.5">
                  {sidebarCategories.map((cat, i) => (
                    <li>
                      <button
                        class={[
                          'w-full flex items-center justify-between py-2 pr-3 text-sm transition-colors text-left border-l-2',
                          i === 0
                            ? 'pl-3.5 border-accent text-accent font-semibold bg-accent/5'
                            : 'pl-4 border-transparent text-slate-700 dark:text-[#B7C4D8] hover:text-accent hover:bg-slate-50 dark:hover:bg-[#172033]',
                        ].join(' ')}
                        data-category-btn
                        data-active={i === 0 ? 'true' : 'false'}
                        data-category={cat.name}
                      >
                        <span>{cat.name}</span>
                        <span class={[
                          'text-xs font-medium px-1.5 py-0.5 border tabular-nums',
                          i === 0 ? 'border-accent/40 text-accent' : 'border-slate-200 dark:border-[#24324A] text-secondary',
                        ].join(' ')}>
                          {cat.count}
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>

            <!-- Tags -->
            {sidebarTags.length > 0 && (
              <div>
                <p class="text-xs uppercase tracking-widest font-semibold text-secondary m-0 mb-3">
                  Tags
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {sidebarTags.map((tag) => (
                    <button
                      class="border border-slate-200 dark:border-[#24324A] px-2.5 py-1 text-xs text-slate-600 dark:text-[#B7C4D8] hover:border-accent hover:text-accent dark:hover:border-accent dark:hover:text-accent transition-colors cursor-pointer bg-transparent"
                      data-tag-btn
                      data-active="false"
                      data-tag={tag.name}
                    >
                      {tag.name}
                      <span class="ml-1 opacity-50 tabular-nums">{tag.count}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

          </div>
        </aside>

        <!-- ─── Feed ───────────────────────────────────────────────────────── -->
        <div class="flex-1 min-w-0 mt-6 lg:mt-0">

          <!-- Filter bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-200 dark:border-[#24324A] mb-1">
            <!-- Left: sort + count -->
            <div class="flex items-center gap-3">
              <label for="sort-select" class="text-xs uppercase tracking-widest font-semibold text-secondary whitespace-nowrap">
                Sort by
              </label>
              <div class="relative">
                <select
                  id="sort-select"
                  class="appearance-none border border-slate-200 dark:border-[#24324A] text-sm text-slate-900 dark:text-[#F3F7FF] px-3 py-1.5 pr-7 bg-white dark:bg-[#111827] hover:border-accent transition-colors cursor-pointer focus:outline-none focus:border-accent"
                >
                  <option value="latest">Latest</option>
                  <option value="oldest">Oldest</option>
                  <option value="reading-time">Reading Time</option>
                </select>
                <Icon
                  name="lucide:chevron-down"
                  class="size-3 text-secondary absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none"
                />
              </div>
              <span id="article-count" class="text-xs text-secondary tabular-nums">
                {posts.length} write-ups
              </span>
            </div>

            <!-- Right: search -->
            <div class="relative">
              <Icon
                name="lucide:search"
                class="size-3.5 text-secondary absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
              />
              <input
                id="search-input"
                type="search"
                placeholder="Search write-ups…"
                class="border border-slate-200 dark:border-[#24324A] text-sm text-slate-900 dark:text-[#F3F7FF] pl-8 pr-4 py-1.5 w-full sm:w-56 focus:outline-none focus:border-accent hover:border-accent transition-colors placeholder:text-slate-400 dark:placeholder:text-[#6F819B] bg-white dark:bg-[#111827]"
              />
            </div>
          </div>

          <!-- Article list -->
          <div id="article-list">
            {posts.map((post) => (
              <ArticleItem
                href={`/write-ups/${post.id}`}
                title={post.data.title}
                excerpt={post.data.excerpt}
                date={post.data.date}
                readingTime={post.data.readingTime}
                category={post.data.category}
                tags={post.data.tags}
              />
            ))}

            <!-- Empty state -->
            <div id="empty-state" class="hidden py-16 text-center">
              <Icon name="lucide:file-search" class="size-10 text-secondary mx-auto mb-3" />
              <p class="text-secondary text-sm m-0">No write-ups match your filters.</p>
            </div>
          </div>

          <!-- Pagination -->
          <div id="pagination" class="hidden items-center justify-between mt-8 pt-6 border-t border-slate-200 dark:border-[#24324A]" data-page-size={pageSize}>
            <button
              id="prev-page"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium border border-slate-200 dark:border-[#24324A] text-slate-700 dark:text-[#B7C4D8] hover:border-accent hover:text-accent transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <Icon name="lucide:arrow-left" class="size-3.5" />
              Newer
            </button>
            <span id="page-info" class="text-xs text-secondary tabular-nums">Page 1 of 1</span>
            <button
              id="next-page"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium border border-slate-200 dark:border-[#24324A] text-slate-700 dark:text-[#B7C4D8] hover:border-accent hover:text-accent transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Older
              <Icon name="lucide:arrow-right" class="size-3.5" />
            </button>
          </div>

        </div>
      </div>
    </div>

    <Footer />
  </div>

  <!-- JSON-LD Schema for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</Layout>

<script>
  // ── Date parsing helper ──────────────────────────────────────────────────
  const MONTHS = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 };
  const pageSize = parseInt(document.getElementById('pagination')?.dataset.pageSize ?? '5', 10);
  function parseDateStr(d) {
    const [mon, yr] = d.split(' ');
    return new Date(parseInt(yr), MONTHS[mon] ?? 0, 1).getTime();
  }

  // ── Mobile filter toggle ─────────────────────────────────────────────────
  const filterToggle  = document.getElementById('filter-toggle');
  const filterPanel   = document.getElementById('filter-panel');
  const filterChevron = document.getElementById('filter-chevron');

  filterToggle?.addEventListener('click', () => {
    const isOpen = !filterPanel?.classList.contains('hidden');
    filterPanel?.classList.toggle('hidden', isOpen);
    filterChevron?.classList.toggle('rotate-180', !isOpen);
    filterToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // ── State ────────────────────────────────────────────────────────────────
  const articleEls   = Array.from(document.querySelectorAll('[data-article]'));
  const countEl      = document.getElementById('article-count');
  const emptyState   = document.getElementById('empty-state');
  const searchInput  = document.getElementById('search-input');
  const paginationEl = document.getElementById('pagination');
  const prevBtn      = document.getElementById('prev-page');
  const nextBtn      = document.getElementById('next-page');
  const pageInfoEl   = document.getElementById('page-info');

  // Capture default (newest-first) order for sort resets
  const defaultOrder = [...articleEls];

  let activeCategory = 'All Write-ups';
  let activeTags     = new Set();
  let searchQuery    = '';
  let currentPage    = 1;

  // ── Filtering ────────────────────────────────────────────────────────────
  function getFiltered() {
    return articleEls.filter(el => {
      const catMatch  = activeCategory === 'All Write-ups' || el.dataset.category === activeCategory;
      const tagMatch  = activeTags.size === 0 ||
        [...activeTags].some(t => (el.dataset.tags ?? '').split(',').includes(t));
      const q         = searchQuery;
      const textMatch = !q ||
        (el.dataset.title ?? '').includes(q) || (el.dataset.excerpt ?? '').includes(q);
      return catMatch && tagMatch && textMatch;
    });
  }

  // ── Render page ──────────────────────────────────────────────────────────
  function renderPage() {
    const filtered   = getFiltered();
    const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const start = (currentPage - 1) * pageSize;
    const end   = start + pageSize;

    articleEls.forEach(el => { el.style.display = 'none'; });
    filtered.slice(start, end).forEach(el => { el.style.display = ''; });

    if (countEl) countEl.textContent = `${filtered.length} write-up${filtered.length !== 1 ? 's' : ''}`;
    if (emptyState) emptyState.classList.toggle('hidden', filtered.length > 0);

    if (totalPages > 1) {
      paginationEl?.classList.remove('hidden');
      paginationEl?.classList.add('flex');
    } else {
      paginationEl?.classList.add('hidden');
      paginationEl?.classList.remove('flex');
    }
    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    if (pageInfoEl) pageInfoEl.textContent = `Page ${currentPage} of ${totalPages}`;
  }

  // ── Category filter ───────────────────────────────────────────────────────
  document.querySelectorAll('[data-category-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'All Write-ups';
      currentPage = 1;

      document.querySelectorAll('[data-category-btn]').forEach((b) => {
        const active = b.dataset.category === activeCategory;
        b.dataset.active = String(active);
        b.className = [
          'w-full flex items-center justify-between py-2 pr-3 text-sm transition-colors text-left border-l-2',
          active
            ? 'pl-3.5 border-accent text-accent font-semibold bg-accent/5'
            : 'pl-4 border-transparent text-slate-700 dark:text-[#B7C4D8] hover:text-accent hover:bg-slate-50 dark:hover:bg-[#172033]',
        ].join(' ');

        const badge = b.querySelector('span:last-child');
        if (badge) {
          badge.className = [
            'text-xs font-medium px-1.5 py-0.5 border tabular-nums',
            active ? 'border-accent/40 text-accent' : 'border-slate-200 dark:border-[#24324A] text-secondary',
          ].join(' ');
        }
      });

      renderPage();
    });
  });

  // ── Tag filter ────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-tag-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        btn.dataset.active = 'false';
        btn.className = 'border border-slate-200 dark:border-[#24324A] px-2.5 py-1 text-xs text-slate-600 dark:text-[#B7C4D8] hover:border-accent hover:text-accent dark:hover:border-accent dark:hover:text-accent transition-colors cursor-pointer bg-transparent';
      } else {
        activeTags.add(tag);
        btn.dataset.active = 'true';
        btn.className = 'border border-accent px-2.5 py-1 text-xs text-accent transition-colors cursor-pointer bg-accent/5';
      }
      currentPage = 1;
      renderPage();
    });
  });

  // ── Search ───────────────────────────────────────────────────────────────
  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value.toLowerCase().trim();
    currentPage = 1;
    renderPage();
  });

  // ── Sort ─────────────────────────────────────────────────────────────────
  document.getElementById('sort-select')?.addEventListener('change', (e) => {
    const order     = e.target.value;
    const container = document.getElementById('article-list');
    if (!container) return;

    if (order === 'latest') {
      defaultOrder.forEach(el => container.insertBefore(el, emptyState));
      articleEls.length = 0;
      articleEls.push(...defaultOrder);
    } else if (order === 'oldest') {
      const rev = [...defaultOrder].reverse();
      rev.forEach(el => container.insertBefore(el, emptyState));
      articleEls.length = 0;
      articleEls.push(...rev);
    } else if (order === 'reading-time') {
      const byTime = [...articleEls].sort(
        (a, b) => parseInt(a.dataset.readingTime ?? '0') - parseInt(b.dataset.readingTime ?? '0')
      );
      byTime.forEach(el => container.insertBefore(el, emptyState));
      articleEls.length = 0;
      articleEls.push(...byTime);
    }
    currentPage = 1;
    renderPage();
  });

  // ── Pagination buttons ────────────────────────────────────────────────────
  prevBtn?.addEventListener('click', () => {
    currentPage--;
    renderPage();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  nextBtn?.addEventListener('click', () => {
    currentPage++;
    renderPage();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── URL category pre-filter ───────────────────────────────────────────────
  const urlCategory = new URLSearchParams(window.location.search).get('category');
  if (urlCategory) {
    const matchBtn = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-btn]'))
      .find(b => b.dataset.category === urlCategory);
    if (matchBtn) matchBtn.click();
  }

  // ── Initial render ────────────────────────────────────────────────────────
  renderPage();
</script>
