---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  function parseDateStr(d: string): number {
    const months: Record<string, number> = {
      Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
      Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11,
    };
    const [mon, yr] = d.split(' ');
    return new Date(parseInt(yr), months[mon] ?? 0, 1).getTime();
  }

  const allPosts = await getCollection('write-ups');
  const sorted = allPosts.sort((a, b) => parseDateStr(b.data.date) - parseDateStr(a.data.date));

  return sorted.map((entry, i) => {
    const prevEntry = sorted[i + 1] ?? null; // older post
    const nextEntry = sorted[i - 1] ?? null; // newer post

    // Resolve related slugs to full post data
    const relatedSlugs = entry.data.related ?? [];
    const relatedPosts = relatedSlugs
      .map(slug => sorted.find(p => p.id === slug))
      .filter((p): p is NonNullable<typeof p> => p != null);

    return {
      params: { slug: entry.id },
      props: { entry, prevEntry, nextEntry, relatedPosts },
    };
  });
}

const { entry, prevEntry, nextEntry, relatedPosts } = Astro.props;
const rendered = await render(entry);
const Content = rendered.Content;

// Use frontmatter ToC if provided, otherwise auto-generate from MDX headings
const toc = entry.data.toc ?? rendered.headings.map(h => ({
  id:    h.slug,
  label: h.text,
  level: h.depth,
}));

const article = {
  title:       entry.data.title,
  subtitle:    entry.data.subtitle,
  category:    entry.data.category,
  date:        entry.data.date,
  readingTime: entry.data.readingTime,
  author:      entry.data.author,
  tags:        entry.data.tags,
  excerpt:     entry.data.excerpt,
};

const prevPost = prevEntry ? { slug: prevEntry.id, title: prevEntry.data.title } : null;
const nextPost = nextEntry ? { slug: nextEntry.id, title: nextEntry.data.title } : null;

const relatedArticles = relatedPosts.map(p => ({
  title:       p.data.title,
  description: p.data.excerpt,
  readingTime: p.data.readingTime,
  category:    p.data.category,
  href:        `/write-ups/${p.id}`,
}));

// SEO Meta Tags
const pageTitle = `${article.title} | Naveen — Full-Stack Developer`;
const pageDescription = article.excerpt || article.subtitle || 'Read this article on software engineering, technology, and personal projects.';
const pageKeywords = [...article.tags, article.category, 'full stack developer', 'Tamil Nadu', 'India'].join(', ');

// Prefer configured site base (Astro.site) for canonical share URLs,
// fallback to the current request URL (useful in local dev).
const pageUrlBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const pageUrl = `${pageUrlBase}${Astro.url.pathname}${Astro.url.search ?? ''}`;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(pageUrl)}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;

// JSON-LD Schemas
const articleSchema = generateArticleSchema({
  title: article.title,
  description: pageDescription,
  datePublished: article.date,
  author: article.author?.name || 'Naveen',
  url: pageUrl,
});

const breadcrumbSchema = generateBreadcrumbSchema({
  items: [
    { name: 'Home', url: pageUrlBase, position: 1 },
    { name: 'Write-ups', url: `${pageUrlBase}/write-ups`, position: 2 },
    { name: article.title, url: pageUrl, position: 3 },
  ],
});
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <div class="min-h-screen pb-24">
    <Navbar />

    <!-- ── ARTICLE HEADER ─────────────────────────────────────────────────── -->
    <header class="border-b border-slate-100 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-4 lg:px-14 pt-7 pb-8">


        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-xs text-secondary mb-5" aria-label="Breadcrumb">
          <a href="/" class="hover:text-accent transition-colors no-underline">Home</a>
          <Icon name="lucide:chevron-right" class="size-3 text-slate-300 dark:text-slate-600 shrink-0" />
          <a href="/write-ups" class="hover:text-accent transition-colors no-underline">Write ups</a>
          <Icon name="lucide:chevron-right" class="hidden md:block  size-3 text-slate-300 dark:text-slate-600 shrink-0" />
          <span class="hidden md:block text-slate-400 dark:text-slate-500 truncate">{article.title}</span>
        </nav>

        <!-- Category badge -->
        <div class="mb-4">
          <span class="border border-accent/40 px-2.5 py-0.5 text-xs text-accent font-semibold uppercase tracking-wider">
            {article.category}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-[1.875rem] sm:text-[2.25rem] font-bold text-slate-900 dark:text-slate-100 leading-[1.2] max-w-[760px] m-0 mb-4 tracking-tight">
          {article.title}
        </h1>

        <!-- Subtitle / excerpt -->
        <p class="text-[0.9375rem] sm:text-base text-secondary leading-relaxed max-w-[640px] m-0 mb-7">
          {article.subtitle}
        </p>

        <!-- Author metadata row -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 justify-between">

          <!-- Left: avatar + author + meta -->
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-accent text-white font-bold text-sm grid place-items-center select-none shrink-0">
              {article.author.initials}
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:gap-0">
              <span class="font-semibold text-slate-900 dark:text-slate-100 text-sm">{article.author.name}</span>
              <div class="flex items-center gap-2.5 text-xs text-secondary sm:ml-3">
                <span class="hidden sm:inline text-slate-200 dark:text-slate-700">&middot;</span>
                <time datetime={article.date}>{article.date}</time>
                <span class="text-slate-200 dark:text-slate-700">&middot;</span>
                <span>{article.readingTime}</span>
              </div>
            </div>
          </div>

          <!-- Right: share actions -->
          <div class="flex items-center gap-1.5">
            <span class="text-xs text-secondary mr-1.5 hidden sm:inline">Share</span>
            <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="p-2 text-secondary hover:text-accent border border-slate-200 dark:border-slate-700 hover:border-accent/40 transition-colors" aria-label="Share on Twitter/X">
              <Icon name="lucide:twitter" class="size-3.5" />
            </a>
            <a href={linkedinShareUrl} target="_blank" rel="noopener noreferrer" class="p-2 text-secondary hover:text-accent border border-slate-200 dark:border-slate-700 hover:border-accent/40 transition-colors" aria-label="Share on LinkedIn">
              <Icon name="lucide:linkedin" class="size-3.5" />
            </a>
          </div>

        </div>
      </div>
    </header>

    <!-- ── TWO-COLUMN CONTENT AREA ─────────────────────────────────────────── -->
    <div class="max-w-7xl mx-auto px-4 lg:px-14 pt-6 lg:pt-10">
      <div class="grid grid-cols-1 xl:grid-cols-[1fr_296px] gap-12 xl:gap-14 items-start">

        <!-- ── LEFT: ARTICLE BODY ──────────────────────────────────────────── -->
        <main class="min-w-0">
          <article class="prose-writeup max-w-[760px]">
            <Content />
          </article>

          <!-- ── PREV / NEXT NAVIGATION ──────────────────────────────────── -->
          <nav class="max-w-[760px] mt-14 pt-8 border-t border-slate-100" aria-label="Write-up navigation">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {prevPost && (
                <a href={`/write-ups/${prevPost.slug}`} class="group flex flex-col gap-1.5 p-4 border border-slate-200 no-underline transition-colors hover:border-accent/40">
                  <span class="flex items-center gap-1.5 text-[0.6875rem] uppercase tracking-[0.06em] font-medium text-slate-400 transition-colors group-hover:text-accent">
                    <Icon name="lucide:arrow-left" class="size-3 shrink-0" />
                    Previous
                  </span>
                  <span class="text-sm font-semibold text-slate-800 leading-[1.4] transition-colors group-hover:text-accent">{prevPost.title}</span>
                </a>
              )}
              {nextPost && (
                <a href={`/write-ups/${nextPost.slug}`} class="group flex flex-col gap-1.5 p-4 border border-slate-200 no-underline transition-colors hover:border-accent/40">
                  <span class="flex items-center justify-end gap-1.5 text-[0.6875rem] uppercase tracking-[0.06em] font-medium text-slate-400 transition-colors group-hover:text-accent">
                    Next
                    <Icon name="lucide:arrow-right" class="size-3 shrink-0" />
                  </span>
                  <span class="text-sm font-semibold text-slate-800 leading-[1.4] text-right transition-colors group-hover:text-accent">
                    {nextPost.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        </main>

        <!-- ── RIGHT: STICKY SIDEBAR ───────────────────────────────────────── -->
        <aside class="hidden xl:block self-start sticky top-8" aria-label="Article sidebar">
          <div>

            <!-- Table of Contents -->
            <div class="pb-[1.375rem] mb-[1.375rem] border-b border-slate-100">
              <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-slate-400 m-0 mb-3.5">On this page</h2>
              <nav id="toc" aria-label="Table of contents">
                <ul class="list-none m-0 p-0">
                  {toc.map(item => (
                    <li class="m-0">
                      <a
                        href={`#${item.id}`}
                        class={`toc-link block no-underline leading-[1.4] transition-colors border-l-2 border-l-transparent text-slate-400 hover:text-accent hover:border-l-slate-300 data-[active]:text-accent data-[active]:border-l-accent data-[active]:font-medium py-[0.3rem] ${item.level === 3 ? 'pl-[1.375rem] text-xs' : 'pl-3 text-[0.8125rem]'}`}
                      >{item.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>

            <!-- Tags -->
            <div class="pb-[1.375rem] mb-[1.375rem] border-b border-slate-100">
              <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-slate-400 m-0 mb-3.5">Tags</h2>
              <div class="flex flex-wrap gap-1.5">
                {article.tags.map(tag => (
                  <span class="inline-flex items-center border border-slate-200 px-2 py-0.5 text-[0.6875rem] font-medium text-slate-500 leading-[1.6] cursor-pointer transition-colors hover:border-accent/40 hover:text-accent">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Share -->
            <div class="pb-[1.375rem] mb-[1.375rem] border-b border-slate-100">
              <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-slate-400 m-0 mb-3.5">Share</h2>
              <div class="flex gap-2 flex-wrap">
                <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.04em] text-slate-500 border border-slate-200 no-underline transition-colors hover:text-accent hover:border-accent/40" aria-label="Share on Twitter/X">
                  <Icon name="lucide:twitter" class="size-3" />
                  <span>Twitter</span>
                </a>
                <a href={linkedinShareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.04em] text-slate-500 border border-slate-200 no-underline transition-colors hover:text-accent hover:border-accent/40" aria-label="Share on LinkedIn">
                  <Icon name="lucide:linkedin" class="size-3" />
                  <span>LinkedIn</span>
                </a>
                <button data-copy-url class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.04em] text-slate-500 border border-slate-200 transition-colors hover:text-accent hover:border-accent/40 cursor-pointer" aria-label="Copy link">
                  <Icon name="lucide:link" class="size-3" />
                  <span data-copy-url-label>Copy link</span>
                </button>
              </div>
            </div>

            <!-- Related Articles -->
            <div>
              <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-slate-400 m-0 mb-3.5">Related Write-ups</h2>
              <ul class="list-none m-0 p-0">
                {relatedArticles.map(rel => (
                  <li class="border-b border-slate-100 last:border-b-0">
                    <a href={rel.href} class="group flex gap-[0.6875rem] items-start py-[0.5625rem] no-underline">
                      <div class="w-1.5 h-1.5 bg-slate-300 rounded-full shrink-0 mt-1.5 transition-colors group-hover:bg-accent" aria-hidden="true"></div>
                      <div class="flex flex-col gap-1 min-w-0">
                        <span class="text-[0.8125rem] font-semibold text-slate-800 leading-[1.35] transition-colors group-hover:text-accent">{rel.title}</span>
                        <span class="text-[0.6875rem] text-slate-400 leading-none">{rel.category} &middot; {rel.readingTime}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </div>

  <Footer />

  <!-- JSON-LD Schemas for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<script>
  // ── COPY BUTTON ─────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-copy-target');
      if (!targetId) return;
      const text = document.getElementById(targetId)?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('span');
        if (label) label.textContent = 'Copied';
        btn.classList.remove('text-slate-400');
        btn.classList.add('text-green-500');
        setTimeout(() => {
          if (label) label.textContent = 'Copy';
          btn.classList.remove('text-green-500');
          btn.classList.add('text-slate-400');
        }, 2000);
      } catch {
        // clipboard unavailable — fail silently
      }
    });
  });

  // ── TOC SCROLL TRACKING ─────────────────────────────────────────────────────
  const headings = document.querySelectorAll<HTMLElement>(
    'article h2[id], article h3[id]'
  );
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');

  if (headings.length > 0 && tocLinks.length > 0) {
    // Activate the first entry on load
    if (tocLinks[0]) tocLinks[0].dataset.active = '';

    const setActive = (id: string) => {
      tocLinks.forEach(link => {
        if (link.getAttribute('href') === `#${id}`) {
          link.dataset.active = '';
        } else {
          delete link.dataset.active;
        }
      });
    };

    const observer = new IntersectionObserver(
      entries => {
        const entering = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (entering.length > 0) {
          setActive((entering[0].target as HTMLElement).id);
        }
      },
      {
        // Top 8% acts as a small offset; bottom 72% ignored (only top portion triggers)
        rootMargin: '-8% 0px -72% 0px',
        threshold: 0,
      }
    );

    headings.forEach(h => observer.observe(h));
  }
</script>

