---
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    icon: 'lucide:clipboard-list',
    title: 'Field Canvassing and Survey Application',
    date: 'January 2022',
    description: 'Developed a Canvassing survey collection system for a U.S. territory, enabling seamless volunteer onboarding, group assignment, and guided data collection. The platform integrates census block maps to help volunteers accurately navigate and capture area-specific survey information. It streamlines coordination, improves data accuracy, and supports efficient large-scale field operations.',
    tags: ['React', 'Node.js', 'PostgreSQL', 'Maps API']
  },
  {
    icon: 'lucide:utensils',
    title: 'Multi Vendor Food Delivery Application',
    date: 'May 2021',
    description: 'App lets users explore multiple restaurants, place orders, and get food delivered by an auto-assigned delivery partner. Each restaurant manages its own menu and orders independently. Built using React Native, it runs smoothly on both iOS and Android, offering real-time tracking, secure payments, and notifications.',
    tags: ['React Native', 'iOS', 'Android', 'Node.js']
  },
  {
    icon: 'lucide:brain',
    title: 'Content Recommender System',
    date: 'May 2020',
    description: 'Collaborative filtering and psychographic models to understand customer similarities. By calculating Euclidean distance between user preference points, it identifies closely related customers and suggests products they are likely to buy. This personalized approach increases engagement, improves user satisfaction, and ultimately boosts sales for the business.',
    tags: ['Python', 'Machine Learning', 'PostgreSQL']
  },
  {
    icon: 'lucide:file-code-2',
    title: 'API Documentation as a Code',
    date: 'October 2025',
    description: 'API documentation generated directly from code provides clearly abstracted methods for HTTP and system APIs. Machine-readable API docs also support code-generation LLMs and Language Server Protocol integrations, allowing them to produce accurate suggestions, and improving the overall developer experience.',
    tags: ['TypeScript', 'OpenAPI', 'LSP', 'LLM']
  }
];
---

<section id="projects" class="flex flex-col border-b border-slate-200 sm:border">
  <header class="flex items-center justify-between px-4 sm:px-5 py-3 sm:py-4">
    <div class="flex items-center gap-1.5 sm:gap-2">
      <Icon name="lucide:briefcase" class="size-4 sm:size-5 text-accent" />
      <h2 class="font-bold text-sm sm:text-2xl text-slate-900 m-0">My Projects</h2>
    </div>
    <a href="#" class="inline-flex items-center gap-1 text-accent text-xs sm:text-sm font-bold hover:underline no-underline whitespace-nowrap">
      <span class="hidden sm:inline">VIEW ALL PROJECTS</span>
      <span class="sm:hidden">VIEW ALL</span>
      <Icon name="lucide:arrow-right" class="size-3 sm:size-4" />
    </a>
  </header>

  <div class="border-t border-slate-200"></div>

  <div class="flex flex-col gap-4">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
