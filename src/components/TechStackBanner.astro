---
const tech = ['Astro', 'TypeScript', 'Node.js', 'Tailwind CSS', 'PostgreSQL', 'React', 'Docker', 'Redis'];
const loopTech = [...tech, ...tech]; // duplicate for seamless loop
---

<section
  class="w-[min(1120px,92%)] mx-auto mt-5 border border-white/8 rounded-2xl overflow-hidden bg-card flex items-stretch"
  aria-label="Technology stack"
>
  <!-- Pinned label -->
  <div class="flex items-center shrink-0 px-5 bg-accent/15 text-white font-bold text-xs tracking-widest uppercase">
    Tech Stack
  </div>

  <!-- Scrolling track -->
  <div class="overflow-hidden flex-1">
    <div class="flex gap-8 w-max px-6 py-4 animate-marquee hover:[animation-play-state:paused]">
      {loopTech.map((item) => (
        <span class="text-secondary font-semibold text-sm whitespace-nowrap">{item}</span>
      ))}
    </div>
  </div>
</section>
