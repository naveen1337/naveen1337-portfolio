---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  readingTime: string;
  category: string;
  tags?: string[];
}

const { href, title, excerpt, date, readingTime, category, tags = [] } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col sm:flex-row sm:items-stretch border-b border-slate-100 last:border-b-0 hover:bg-slate-50/60 dark:hover:bg-[#172033] px-3 -mx-3 transition-colors no-underline"
  data-article
  data-title={title.toLowerCase()}
  data-excerpt={excerpt.toLowerCase()}
  data-category={category}
  data-tags={tags.join(',')}
  data-date={date}
  data-reading-time={readingTime}
>
  <!-- Timeline column: dot + vertical connecting line (desktop only) -->
  <div class="hidden sm:flex flex-col items-center w-6 shrink-0 pt-5">
    <span class="w-3 h-3 rounded-full border-2 border-accent bg-white dark:bg-[#0A0F1C] shrink-0"></span>
    <span class="w-px bg-slate-200 dark:bg-[#24324A] flex-1 mt-1.5 group-last:hidden"></span>
  </div>

  <!-- Date column (desktop) -->
  <div class="hidden sm:block w-24 shrink-0 pt-5 pb-5 pl-3">
    <time class="text-xs text-secondary tabular-nums font-medium leading-relaxed">{date}</time>
  </div>

  <!-- Content column -->
  <div class="flex-1 min-w-0 pt-4 sm:pt-5 pb-4 sm:pb-5 sm:pl-4">
    <!-- Mobile: date sits above title -->
    <time class="sm:hidden block text-xs text-secondary tabular-nums font-medium mb-1.5">{date}</time>
    <h3 class="font-bold text-slate-900 text-base leading-snug m-0 mb-1.5 group-hover:text-accent transition-colors">
      {title}
    </h3>
    <p class="text-secondary text-sm m-0 leading-relaxed line-clamp-2">{excerpt}</p>

    <!-- Mobile: metadata row below excerpt -->
    <div class="flex items-center gap-3 mt-2.5 sm:hidden">
      <span class="text-xs text-secondary">{readingTime}</span>
      <span class="border border-accent/40 px-2 py-0.5 text-xs text-accent font-semibold">{category}</span>
    </div>
  </div>

  <!-- Metadata column (desktop only: reading time + category badge) -->
  <div class="hidden sm:flex flex-col items-end w-40 shrink-0 gap-2 pt-5 pb-5">
    <span class="text-xs text-secondary whitespace-nowrap">{readingTime}</span>
    <span class="border border-accent/40 px-2.5 py-0.5 text-xs text-accent font-semibold whitespace-nowrap">
      {category}
    </span>
  </div>
</a>
